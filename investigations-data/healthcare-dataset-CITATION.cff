    value: "10.5281/zenodo.23600573"
    description: "Zenodo record for this reduced deposit"
keywords:
  - healthcare costs
  - international comparison
  - consumer protection
  - United States
  - United Kingdom
  - Germany
  - Spain
license: "CC-BY-4.0"
url: "https://www.getkibbo.com/investigations/healthcare-cost-comparison"
